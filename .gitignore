# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Databases & Runtime Telemetry
*.db
*.sqlite
*.sqlite3
maple/data/*.db
data/*.db
game_memory.json
data/game_memory.json

# Logs & Temporary Files
logs/
maple/logs/
*.log
temp/
tmp/
*.tmp

# Images, Screenshots & Runtime Captures
*.png
*.jpg
*.jpeg
*.bmp
*.webp
*.gif
maple/data/browser_session/

